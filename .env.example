# ============================================================
# Autoura — environment template
# ============================================================
# Copy to .env.local and fill in. T2 of docs/plans/self-hosting.md.
#
# Every variable below is read by the application. It was derived by grepping
# process.env across app/, lib/, components/, middleware.ts and
# instrumentation.ts — not copied from another project — and a test
# (__tests__/env-example-sync.test.ts) fails if the code and this file drift
# apart. If you add a process.env read, add it here.
#
# NOT listed here, deliberately:
#   DATABASE_URL   — only scripts/migrate.mjs reads it, only when applying
#                    migrations. See docs/SELF-HOSTING.md. Do not leave it in
#                    .env.local; it is a write credential the app never needs.
#   E2E_*, SCREENSHOT_*, PRICING_DEBUG, GIT_SHA, GITHUB_RUN_ID
#                  — development and CI tooling, not the running app.
#   NODE_ENV, NEXT_RUNTIME, RAILWAY_*
#                  — injected by the platform. Never set these yourself.
#
# Variables you may find in an older .env and can DELETE: DEFAULT_CURRENCY,
# MARKUP_PERCENTAGE, GMAIL_APP_PASSWORD. Nothing reads them (verified
# 2026-08-29); mail goes through connected-Gmail OAuth, not an app password.


# ------------------------------------------------------------
# REQUIRED — the app will not work without these
# ------------------------------------------------------------

# Supabase project. URL and anon key are public (they reach the browser);
# the service-role key is not — it bypasses row-level security entirely.
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The public origin this install is served from. Used to build invitation
# links, portal links and OAuth redirects, so a wrong value produces links
# that go nowhere. No trailing slash.
NEXT_PUBLIC_APP_URL=https://autoura.example.com


# ------------------------------------------------------------
# REQUIRED ON A SELF-HOSTED INSTALL — scheduled jobs
# ------------------------------------------------------------
# This app schedules its own jobs in-process (instrumentation.ts), so there is
# no cron to configure. BUT the scheduler only arms itself on Railway
# (RAILWAY_SERVICE_NAME) or when this is explicitly "true".
#
# On your own server neither is true by default, so WITHOUT THIS LINE nothing
# runs: exchange rates never refresh, reminders never send, expired traveller
# documents are never purged. Nothing errors — the jobs simply never happen.
CRON_IN_PROCESS=true

# Shared secret for the /api/cron/* endpoints, so they can also be triggered
# externally. Any long random string: `openssl rand -base64 32`.
CRON_SECRET=


# ------------------------------------------------------------
# REQUIRED IF YOU CONNECT GOOGLE / GMAIL — token encryption
# ------------------------------------------------------------
# OAuth refresh tokens are encrypted at rest with this. Code THROWS on first
# use if it is unset, so connecting Google without it fails loudly.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=


# ------------------------------------------------------------
# RECOMMENDED — signing secrets
# ------------------------------------------------------------
# Both fall back to SUPABASE_SERVICE_ROLE_KEY when unset. That works, but it
# makes two unrelated signing secrets the same value as the key that bypasses
# RLS — so rotating one forces rotating everything. Set them separately.
# Generate each: openssl rand -base64 32
OAUTH_STATE_SECRET=
PORTAL_VERIFY_SECRET=


# ------------------------------------------------------------
# YOUR AGENCY — appears in documents, emails and the portal
# ------------------------------------------------------------
BUSINESS_NAME=
BUSINESS_EMAIL=
BUSINESS_WEBSITE=
BUSINESS_WHATSAPP=


# ------------------------------------------------------------
# OPTIONAL — AI features
# ------------------------------------------------------------
# Without ANTHROPIC_API_KEY, WhatsApp parsing and itinerary generation are
# unavailable. Everything else works.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=


# ------------------------------------------------------------
# OPTIONAL — Google / Gmail (email inbox, sending, calendar)
# ------------------------------------------------------------
# All outbound email goes through the connected Gmail account. If this is not
# configured, or the connection lapses, sends fail — check that first when
# mail stops arriving. GOOGLE_REDIRECT_URI must match your Google console
# entry exactly, including the host in NEXT_PUBLIC_APP_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://autoura.example.com/api/auth/google/callback
GMAIL_USER=


# ------------------------------------------------------------
# OPTIONAL — WhatsApp via Twilio
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_NUMBER=

# Leave both false until you have watched the drafts it produces.
ENABLE_WHATSAPP_AUTO_SEND=false
ENABLE_WHATSAPP_STATUS_UPDATES=false


# ------------------------------------------------------------
# OPTIONAL — accounting sync
# ------------------------------------------------------------
# Never runtime-tested against a live account. Treat as experimental.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
QUICKBOOKS_ENVIRONMENT=sandbox


# ------------------------------------------------------------
# OPTIONAL — customer review link
# ------------------------------------------------------------
# Sent in the thank-you WhatsApp message after a trip. IF YOU DO NOT SET THIS
# your customers are sent to Travel2Egypt's Google review page, because that is
# the hardcoded default (app/api/whatsapp/send-thankyou). See the "Known
# limitations" section of docs/SELF-HOSTING.md.
REVIEW_URL=

# ------------------------------------------------------------
# OPTIONAL — exchange rates
# ------------------------------------------------------------
# Without this, historical currency conversion falls back to whatever rates
# are already stored. Reports do not error; they quietly stop being accurate.
EXCHANGE_RATE_API_KEY=


# ------------------------------------------------------------
# OPTIONAL — inbound partner webhook
# ------------------------------------------------------------
# Set _PREVIOUS to the old value while rotating, so in-flight requests signed
# with the old secret still verify. Remove it once rotation is complete.
CONCIERGE_WEBHOOK_SECRET=
CONCIERGE_WEBHOOK_SECRET_PREVIOUS=


# ------------------------------------------------------------
# ADVANCED — leave unset unless you know you need them
# ------------------------------------------------------------
# Pins which organization unscoped code paths resolve to. Unset, the app uses
# the first organization, which is correct for a single-agency install.
DEFAULT_ORG_ID=

# Legacy fallback for NEXT_PUBLIC_APP_URL in OAuth callbacks. Set the latter
# instead; this exists only so older configurations keep working.
NEXTAUTH_URL=
